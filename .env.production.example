# ============================================================
#  ENVIRONMENT: PRODUCTION (untuk deploy)
#  Salin file ini menjadi `.env` di server, lalu sesuaikan nilai.
#  Jangan gunakan file ini sebagai `.env` lokal (dev)!
# ============================================================

APP_NAME="RPL2 FoodOrder"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://NAMA-AKU-app.onrender.com   # ganti dengan URL app di Render

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

# ------------------------------------------------------------
# DATABASE
# Utamakan MySQL (opsi gratis: TiDB Cloud Serverless).
# DB_* wajib diisi sesuai credentials dari TiDB Cloud.
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=NAMA_DATABASE
DB_USERNAME=NAMA_USER.root
DB_PASSWORD=PASSWORD_DB

# Kalau mau fallback ke SQLite + Persistent Disk di Render,
# setel sebagai berikut (dan matikan opsi MySQL di atas):
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/data/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
