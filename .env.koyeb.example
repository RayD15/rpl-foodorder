# ============================================================
#  ENV untuk KOYEB — deploy RPL2 FoodOrder (Laravel + Apache Docker)
#  Salin nilai dari .env.tidb (local, tidak di-commit) ke dashboard Koyeb.
#  Setiap baris "KEY=value" = satu Environment Variable di Koyeb.
#  GANTI semua nilai dengan 'TULIS_SINi' sebelum dipakai.
# ============================================================

# --- Aplikasi ---
APP_NAME="RPL2 FoodOrder"
APP_ENV=production
# Biarkan kosong: docker-entrypoint.sh otomatis generate APP_KEY saat start.
APP_KEY=
APP_DEBUG=false
# Ganti dengan URL app kamu nanti (format: https://<nama>-<org>.koyeb.app)
APP_URL=https://rpl2-foodorder-TULIS_ORG_KAMU.koyeb.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database (TiDB Cloud Serverless - MySQL-compatible) ---
# Ambil nilai asli dari .env.tidb di komputer kamu (jangan pakai yang di sini).
DB_CONNECTION=mysql
DB_HOST=GATEWAY_TIDB_KAMU
DB_PORT=4000
DB_DATABASE=rpl_foodorder
DB_USERNAME=USER_KAMU.root
DB_PASSWORD=PASSWORD_TIDB_KAMU
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

# --- Session / Cache / Queue ---
# Disimpan di database (TiDB) supaya tidak hilang saat Koyeb restart.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Lainnya ---
FILESYSTEM_DISK=local
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
